# ============================================================================
# Webhook Ingestion Engine - Environment Configuration Template
# COPY THIS FILE TO .env AND REPLACE PLACEHOLDER VALUES
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL
# ============================================================================

# Application Environment
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# PostgreSQL Configuration
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:CHANGE_ME_PASSWORD@localhost:5432/webhook_engine
DB_POOL_MAX=20

# Redis Configuration (Streams & Caching)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Stream Sharding Settings
STREAM_SHARD_COUNT=16
STREAM_PREFIX=webhooks:stream

# Downstream Service Configuration
DOWNSTREAM_URL=http://localhost:4000/downstream
MOCK_DOWNSTREAM_PORT=4000

# Safety & Circuit Breaker Thresholds
MAX_STREAM_QUEUE_LENGTH=50000
CIRCUIT_BREAKER_ERROR_THRESHOLD=50
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000

# Admin & DLQ Operations Authentication Key (Minimum 16 characters)
ADMIN_API_KEY=CHANGE_ME_ADMIN_KEY_MIN_16_CHARS

