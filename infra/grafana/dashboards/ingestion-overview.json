{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Ingestion Gateway Overview",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "title": "Ingestion Request Rate (RPS by Status)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(webhook_gateway_requests_total[1m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 3,
      "title": "Gateway Ingestion Latency (p95 & p99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(webhook_gateway_latency_ms_bucket[1m])) by (le))",
          "legendFormat": "p99 (target < 15ms)"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(webhook_gateway_latency_ms_bucket[1m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1000 },
              { "color": "red", "value": 5000 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 4,
      "title": "Stream Shard Backlog Depth",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(webhook_stream_backlog_records) by (shard)",
          "legendFormat": "{{shard}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 5,
      "title": "Worker Pool, Idempotency & State Machine",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "id": 6,
      "title": "Idempotency Duplicate Events Filtered",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(webhook_idempotency_hits_total[1m])) by (tier)",
          "legendFormat": "{{tier}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "id": 7,
      "title": "Out-of-Order Hydration & OCC Resolutions",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(webhook_out_of_order_resolved_total[1m])) by (resolution)",
          "legendFormat": "{{resolution}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "id": 8,
      "title": "Tenant Circuit Breaker States (0=CLOSED, 1=HALF_OPEN, 2=OPEN)",
      "type": "stat",
      "targets": [
        {
          "expr": "webhook_tenant_circuit_breaker_state",
          "legendFormat": "Tenant {{tenant_id}}"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["webhook", "ingestion", "fastify", "redis", "postgres"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
  "timezone": "browser",
  "title": "Webhook Ingestion Engine Overview",
  "uid": "webhook-ingestion-overview",
