{
  "name": "webhook-ingestion-engine",
  "version": "1.0.0",
  "description": "Multi-Tenant Fault-Tolerant Webhook Ingestion Engine with Redis Streams, PostgreSQL, Shuffle Sharding, and Two-Phase Idempotency",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev:gateway": "tsx watch src/gateway/server.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "dev:mock": "tsx watch src/mock-downstream/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration"
  },
  "keywords": [
    "webhook",
    "ingestion",
    "redis-streams",
    "postgresql",
    "idempotency",
    "multi-tenant",
    "shuffle-sharding",
    "fault-tolerant"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-raw-body": "^6.0.3",
    "ioredis": "^5.4.2",
    "lru-cache": "^11.0.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  },
  "overrides": {
    "cookie": "^0.7.2"
  }
}
